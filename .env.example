# Base origin or deployment prefix, WITHOUT /api/v1. HTTP is for local development only.
API_BASE_URL=http://localhost:8000
# Used on the server for content and to supply a validated backend address to forms.
# HTTPS canonical production origin. Omit in unconfigured local development.
SITE_URL=http://localhost:3000
# Independent >=32-character secret, matching the existing backend setting.
NEXTJS_REVALIDATION_SECRET=
# Comma-separated exact hostnames allowed through Next/Netlify image optimization.
IMAGE_REMOTE_HOSTS=
# Optional approved public address. Omit to hide email contact methods.
CONTACT_EMAIL=


# Server-only; match ANALYTICS_INGEST_SECRET in the backend (>=32 characters).
# Omit to disable traffic collection. Never add NEXT_PUBLIC_ to this name.
ANALYTICS_INGEST_SECRET=

# Server-only consumer credentials matching the backend; never expose these in browser config.
API_USER=
API_KEY=
